# =============================================================================
# GENERATED BY TERRAFORM - do not edit by hand.
# Regenerate with: cd terraform && terraform apply
# =============================================================================

[web]
web-server ansible_host=${web_public_ip}

[db]
db-server ansible_host=${db_private_ip}

# ---------------------------------------------------------------------------
# The DB server has no public IP, so Ansible cannot reach it directly.
# ProxyCommand tells SSH: "first connect to the web server, then from there
# open a tunnel to the database server." The web server acts as a bastion.
# ---------------------------------------------------------------------------
[db:vars]
ansible_ssh_common_args=-o ProxyCommand="ssh -W %h:%p -q -i ${ssh_key_path} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ubuntu@${web_public_ip}"

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=${ssh_key_path}
ansible_python_interpreter=/usr/bin/python3

# Facts about the environment, available to every playbook as variables.
web_public_ip=${web_public_ip}
db_private_ip=${db_private_ip}
admin_cidr=${admin_cidr}
vpc_cidr=${vpc_cidr}
public_subnet_cidr=${public_subnet_cidr}
